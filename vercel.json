{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/rental",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rental/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/zaiko",
      "destination": "/zaiko/index.html"
    },
    {
      "source": "/zaiko/(items|products|locations)/(.*)",
      "destination": "/zaiko/index.html"
    },
    {
      "source": "/zaiko/(list|in|out|loan|stock|locations|history|register|labels|rental-requests)",
      "destination": "/zaiko/index.html"
    },
    {
      "source": "/images/products/CI7P000118.webp",
      "destination": "https://meraki.cisco.com/wp-content/uploads/2022/09/MR28-product-wireless-lan-tile.png"
    },
    {
      "source": "/images/products/PZ1AA06CA0.webp",
      "destination": "https://www.fortinet.com/blog/business-and-technology/fortinet-announces-fortigate-60f-ngfw/_jcr_content/root/responsivegrid/image.img.png/1572470288517/fortigate-fig-one.png"
    },
    {
      "source": "/images/products/OH3B010130.webp",
      "destination": "https://panasonic.jp/cns/pc/products/fv5g/img/top/fv_model.png"
    }
  ]
}
